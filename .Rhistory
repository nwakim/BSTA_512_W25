# Chunk 1
#| message: false
library(tidyverse)
library(gtsummary)
library(here)
if(!require(lubridate)) { install.packages("lubridate"); library(lubridate) }
#| echo: false
here()
iat_2021_raw = read.csv(file = here("../TA_files/Project/data/Weight_IAT.public.2021.csv"))
summary(iat_2021_raw$ethnicityomb)
table(iat_2021_raw$ethnicityomb)
table(iat_2021_raw$religionid)
#| eval: false
#load in data
IAT21 = read.csv(file = here("../TA_files/Project/data/Weight_IAT.public.2021.csv"))
IAT21_1 <- IAT21 %>%
select(D_biep.Thin_Good_all, #IAT score (outcome)
iam_001,              #self-perception of weight 1
controlother_001,     #controllability of others' weight 2
controlyou_001,       #controllability of own weight 3
birthmonth, birthyear, month, year, #for calculating age 4
raceomb_002,      #adding 2/20 for Lab 3
raceombmulti,         #multiple selection race 5
ethnicityomb,         #hispanic/latino ethnicity 6
birthSex,             #sex assigned at birth 7
edu_14,               #education 8
politicalid_7) %>%    #political affiliation 9
rename(score = D_biep.Thin_Good_all,     #renaming some variables
iam = iam_001,
controlother = controlother_001,
controlyou = controlyou_001)
View(IAT21_1)
summary(IAT21_1)
IAT21_2 = IAT21_1 %>%
mutate(iam_cat = case_match(iam,
7 ~ "Very overweight",       #matching number to label
6 ~ "Moderately overweight",
5 ~ "Slightly overweight",
4 ~ "Neither underweight nor overweight",
3 ~ "Slightly underweight",
2 ~ "Moderately underweight",
1 ~ "Very underweight",
.default = NA) %>% factor(levels = c("Very underweight",       #dictating order
"Moderately underweight",
"Slightly underweight",
"Neither underweight nor overweight",
"Slightly overweight",
"Moderately overweight",
"Very overweight"))) %>%
mutate(controlother_cat = case_match(controlother,
5 ~ "No control",
4 ~ "A little control",
3 ~ "Some control",
2 ~ "A lot of control",
1 ~ "Complete control",
.default = NA) %>% factor(levels = c("No control",
"A little control",
"Some control",
"A lot of control",
"Complete control"))) %>%
mutate(controlyou_cat = case_match(controlyou,
5 ~ "No control",
4 ~ "A little control",
3 ~ "Some control",
2 ~ "A lot of control",
1 ~ "Complete control",
.default = NA) %>% factor(levels = c("No control",
"A little control",
"Some control",
"A lot of control",
"Complete control"))) %>%
mutate(ethnicity_cat = case_match(ethnicityomb,
3 ~ "Unknown",
2 ~ "Not Hispanic or Latino",
1 ~ "Hispanic or Latino",
.default = NA)  %>% factor(levels = c("Hispanic or Latino",
"Not Hispanic or Latino",
"Unknown"))) %>%
mutate(SAB_cat = case_match(birthSex,
2 ~ "Female",
1 ~ "Male",
.default = NA)  %>% factor(levels = c("Female",
"Male"))) %>%
mutate(edu_cat = case_match(edu_14,
14 ~ "MBA",
13 ~ "other advanced degree",
12 ~ "PhD",
11 ~ "MD",
10 ~ "JD",
9 ~ "master's degree",
8 ~ "some graduate school",
7 ~ "bachelor's degree",
6 ~ "associate's degree",
5 ~ "some college",
4 ~ "high school graduate",
3 ~ "some high school",
2 ~ "junior high",
1 ~ "elementary school",
.default = NA) %>% factor(levels = c("elementary school",
"junior high",
"some high school",
"high school graduate",
"some college",
"associate's degree",
"bachelor's degree",
"some graduate school",
"master's degree",
"MBA",
"JD",
"MD",
"PhD",
"other advanced degree"))) %>%
mutate(political_cat = case_match(politicalid_7,
7 ~ "strongly liberal",
6 ~ "moderately liberal",
5 ~ "slightly liberal",
4 ~ "neutral",
3 ~ "slightly conservative",
2 ~ "moderately conservative",
1 ~ "strongly conservative",
.default = NA) %>% factor(levels = c("strongly conservative",
"moderately conservative",
"slightly conservative",
"neutral",
"slightly liberal",
"moderately liberal",
"strongly liberal"))) %>%
mutate(race_cat = case_match(raceomb_002, #added in 2/21 to do more exploration
1 ~ "American Indian/Alaska Native",
2 ~ "East Asian",
3 ~ "South Asian",
4 ~ "Native Hawaiian or other Pacific Islander",
5 ~ "Black or African American",
6 ~ "White",
7 ~ "Other or Unknown",
8 ~ "Multiracial") %>% factor())
summary(IAT21_2)
# code directly from course website
# make birthdate and testdate from year and month
IAT21_3 = IAT21_2 %>%
mutate(birthdate = make_date(month = birthmonth, year = birthyear),
testdate = make_date(month = month, year = year))
# calc age and remove variables used above in this code chunk
IAT21_4 = IAT21_3 %>%
mutate(age = interval(start = birthdate,
end = testdate) %>% #create age variable
as.period() %>% year()) %>%
select(-birthmonth, -birthyear, -year, -month, #remove used variables
-testdate, -birthdate)
View(IAT21_4)
#keep only complete cases
IAT21_complete = IAT21_4 %>% drop_na()
nrow(IAT21_complete) #9875 :/
